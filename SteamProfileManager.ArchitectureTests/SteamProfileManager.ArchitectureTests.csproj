<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <ExcludeFromCodeCoverage>true</ExcludeFromCodeCoverage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="TngTech.ArchUnitNET.NUnit" Version="0.13.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SteamProfileManager/SteamProfileManager.csproj" />
    <None Include="../SteamProfileManager/SteamProfileManager.csproj"
          Link="ProductionProjects/SteamProfileManager.csproj"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>