  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="NuciExtensions" Version="6.0.2" />
    <PackageReference Include="NuciLog" Version="1.2.1" />
    <PackageReference Include="NuciLog.Core" Version="3.1.0" />
    <PackageReference Include="NuciWeb" Version="4.1.0" />
    <PackageReference Include="NuciWeb.Automation" Version="1.0.1" />
    <PackageReference Include="NuciWeb.Automation.Selenium" Version="1.0.3" />
    <PackageReference Include="NuciWeb.Steam" Version="1.5.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
